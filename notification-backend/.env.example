# Django Settings
DEBUG=True
SECRET_KEY=your-secret-key-here
ALLOWED_HOSTS=localhost,127.0.0.1,yourdomain.com

# CORS Settings
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# WhatsApp (Sandbox)
WHATSAPP_ACCESS_TOKEN=your_test_token_here
WHATSAPP_PHONE_NUMBER_ID=your_test_phone_number_id_here

# Postmark (or alternative email service)
POSTMARK_TOKEN=your_postmark_server_token_here
POSTMARK_FROM_EMAIL=your_verified_email@example.com

# OneSignal (Web Push)
ONESIGNAL_APP_ID=your_onesignal_app_id_here
ONESIGNAL_REST_API_KEY=your_onesignal_rest_api_key_here
